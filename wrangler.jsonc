{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static site only: a Worker serving dist/ as assets. No server code.
  "name": "cubemonke",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "cubemonke.com", "custom_domain": true }],
  "workers_dev": false
}
